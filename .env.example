# Copy to .env and set credentials locally. Never commit the real URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
AI_PUSH_KEY=replace-with-your-ai-push-key
TV_WEBHOOK_TOKEN=replace-with-your-tradingview-token
PORT=8788
BRIDGE_URL=http://127.0.0.1:8790
# Optional shared password for public VPS access; without it the server binds localhost.
# GOLD_WEB_PASS=
